# 운영(EC2)용 환경 변수 예시. EC2에서 `cp .env.prod.example .env.prod` 후 값을 바꿔 쓴다.
# 진짜 값이 든 .env.prod는 Git에 올리지 않는다 (.gitignore).
DB_USERNAME=hooklens
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-long-random-root
# 화면에 보여 줄 웹훅 주소의 앞부분. EC2 공인 IP로 바꾼다 (예: http://13.125.10.20)
HOOKLENS_BASE_URL=http://EC2-PUBLIC-IP
